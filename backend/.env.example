APP_NAME=Intelligent File Deduplication System
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/file_deduplication

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

STORAGE_ROOT=storage
UPLOAD_DIRECTORY=uploads
TEMP_DIRECTORY=temp

MAX_FILE_SIZE_MB=1024
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,csv,xls,xlsx,ppt,pptx,jpg,jpeg,png,gif,zip,rar,7z

CORS_ORIGINS=http://localhost:5173